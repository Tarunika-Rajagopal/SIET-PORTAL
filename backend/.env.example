# Database connection (PostgreSQL / Supabase connection pooler or local SQLite)
# Example for Supabase: postgresql+asyncpg://postgres.<project-ref>:<db-password>@<host>:6543/postgres
# Example for local SQLite: sqlite+aiosqlite:///./tests/siet_portal.db
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Security
JWT_SECRET_KEY=replace-with-secure-random-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
